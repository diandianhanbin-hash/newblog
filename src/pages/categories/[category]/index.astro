---
import Base from '../../../layouts/Base.astro';
import PostGrid from '../../../components/PostGrid.astro';
import { getPosts, groupPosts } from '../../../lib/posts';

export async function getStaticPaths() {
  return groupPosts(await getPosts(), 'categories').map(({ name, entries }) => ({
    params: { category: name }, props: { name, entries },
  }));
}
const { name, entries } = Astro.props;
---
<Base title={name + ' · 分类'}>
  <section class="shell page-section">
    <header class="page-heading">
      <a class="text-link" href="/categories/">全部分类</a>
      <h1>{name}</h1><p>{entries.length} 篇文章</p>
    </header>
    <PostGrid posts={entries} />
  </section>
</Base>
