---
import Base from '../layouts/Base.astro';
import PostGrid from './PostGrid.astro';
import { groupPosts, homePageUrl, postsPerPage, type Post } from '../lib/posts';
import { site } from '../lib/site';

const { posts, page } = Astro.props as { posts: Post[]; page: number };
const totalPages = Math.ceil(posts.length / postsPerPage);
const tagCount = groupPosts(posts, 'tags').length;
const start = (page - 1) * postsPerPage;
---
<Base title={page > 1 ? '文章 · 第 ' + page + ' 页' : undefined}>
  {page === 1 && (
    <section class="hero">
      <div class="shell hero-inner">
        <h1>Less is more<span>.</span></h1>
        <p class="hero-name">点点寒彬的学习日志</p>
        <p class="hero-intro">{site.introduction}</p>
        <div class="hero-stats">
          <a href="/timeline/" aria-label={posts.length + ' 篇文章，查看时间线'}><strong>{posts.length}</strong><span>篇文章</span></a>
          <a href="/tag/" aria-label={tagCount + ' 个标签，查看所有标签'}><strong>{tagCount}</strong><span>个标签</span></a>
        </div>
      </div>
    </section>
  )}
  <section class="shell page-section" aria-labelledby="latest-title">
    <div class="section-heading">
      {page === 1 ? <h2 id="latest-title">最新文章</h2> : <h1 id="latest-title">文章</h1>}
      <a class="text-link" href="/timeline/">全部归档</a>
    </div>
    <PostGrid posts={posts.slice(start, start + postsPerPage)} excerpts />
    {totalPages > 1 && (
      <nav class="pagination" aria-label="文章分页">
        {page > 1 ? <a href={homePageUrl(page - 1)} rel="prev">上一页</a> : <span class="page-edge"></span>}
        <span>第 {page} / {totalPages} 页</span>
        {page < totalPages ? <a href={homePageUrl(page + 1)} rel="next">下一页</a> : <span class="page-edge"></span>}
      </nav>
    )}
  </section>
</Base>
